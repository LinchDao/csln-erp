<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.csln.mapper.StockMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lin.csln.entity.StockDO">
        <id column="id" property="id"/>
        <result column="warehouse_id" property="warehouseId"/>
        <result column="sku_id" property="skuId"/>
        <result column="qty" property="qty"/>
        <result column="lock_qty" property="lockQty"/>
        <result column="recovery_qty" property="recoveryQty"/>
        <result column="warn_qty" property="warnQty"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, warehouse_id, sku_id, qty, lock_qty, recovery_qty, warn_qty, update_time
    </sql>

</mapper>
