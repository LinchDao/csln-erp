<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.csln.mapper.CustomerMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lin.csln.entity.CustomerDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="level_id" property="levelId"/>
        <result column="address" property="address"/>
        <result column="remark" property="remark"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, phone, level_id, address, remark, status, create_time
    </sql>

    <select id="pageCustomer" parameterType="com.lin.csln.dto.sys.customer.CustomerQueryParamDTO"
            resultType="com.lin.csln.dto.sys.customer.CustomerPageRespDTO">
        SELECT
            c.id,
            c.name,
            c.phone,
            c.level_id AS levelId,
            c.address,
            c.remark,
            c.status,
            DATE_FORMAT(c.create_time, '%Y-%m-%d %H:%i:%s') AS createTime
        FROM customer c
        <where>
            <if test="params.name != null and params.name != ''">
                AND c.name LIKE CONCAT('%', #{params.name}, '%')
            </if>
            <if test="params.phone != null and params.phone != ''">
                AND c.phone LIKE CONCAT('%', #{params.phone}, '%')
            </if>
            <if test="params.status != null">
                AND c.status = #{params.status}
            </if>
        </where>
        ORDER BY c.create_time DESC
    </select>

</mapper>
