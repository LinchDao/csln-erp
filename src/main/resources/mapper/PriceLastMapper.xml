<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.csln.mapper.PriceLastMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lin.csln.entity.PriceLastDO">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="customer_id" property="customerId"/>
        <result column="last_price" property="lastPrice"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, product_id, customer_id, last_price, update_time
    </sql>

</mapper>
