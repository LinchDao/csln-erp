<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.csln.mapper.SalesStatisticsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lin.csln.entity.SalesStatisticsDO">
        <id column="id" property="id"/>
        <result column="stat_date" property="statDate"/>
        <result column="stat_type" property="statType"/>
        <result column="shop_id" property="shopId"/>
        <result column="sales_user_id" property="salesUserId"/>
        <result column="order_count" property="orderCount"/>
        <result column="total_qty" property="totalQty"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="cost_amount" property="costAmount"/>
        <result column="profit_amount" property="profitAmount"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, stat_date, stat_type, shop_id, sales_user_id, order_count, total_qty, total_amount, cost_amount, profit_amount
    </sql>

</mapper>
