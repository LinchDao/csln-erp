<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.csln.mapper.FileMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lin.csln.entity.FileDO">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="storage_file_name" property="storageFileName"/>
        <result column="file_path" property="filePath"/>
        <result column="full_file_path" property="fullFilePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="file_extension" property="fileExtension"/>
        <result column="content_type" property="contentType"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user" property="createUser"/>
        <result column="is_delete" property="isDelete"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, file_name, storage_file_name, file_path, full_file_path, file_size, file_type, file_extension, content_type, create_time, create_user, is_delete
    </sql>

</mapper>
