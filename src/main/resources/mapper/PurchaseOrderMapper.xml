<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.csln.mapper.PurchaseOrderMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lin.csln.entity.PurchaseOrderDO">
        <id column="id" property="id"/>
        <result column="purchase_no" property="purchaseNo"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="total_qty" property="totalQty"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="status" property="status"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, purchase_no, supplier_id, total_qty, total_amount, status, create_user_id, create_time, remark
    </sql>

</mapper>
